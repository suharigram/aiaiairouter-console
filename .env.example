# Local PostgreSQL port used by compose.yaml. Keep the URLs below in sync if you change it.
POSTGRES_PORT="5432"
# Local development database. In production, use the Supabase pooled connection (port 6543) instead.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/aiaiairouter"
# Direct connection used by Prisma migrations; it is the same URL for local development.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/aiaiairouter"

# Supabase project settings. The service role key is server-only; never expose it in NEXT_PUBLIC variables.
SUPABASE_URL="https://project-ref.supabase.co"
SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
NEXT_PUBLIC_SUPABASE_URL="https://project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"

# Public origin without a trailing slash. APP_URL may be the same origin in a single-app deployment.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# At least 32 random bytes, base64 or hex. Used for HMAC fingerprints and API-key hashing.
AUTH_SECRET="replace-with-64-random-characters-for-local-development-only"

# Configure these OAuth credentials in Supabase Auth providers; the app does not ship secrets to the browser.
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
GITHUB_CLIENT_ID="replace-with-github-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-client-secret"

# Stripe server-side keys and one-time Payment Price IDs. Credits equal the paid amount in USD.
STRIPE_SECRET_KEY="sk_test_replace_with_stripe_secret"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_webhook_secret"
STRIPE_PRICE_SMALL="price_replace_small_10_usd"
STRIPE_PRICE_MEDIUM="price_replace_medium_25_usd"
STRIPE_PRICE_LARGE="price_replace_large_100_usd"

# EMAIL_PROVIDER=resend uses RESEND_API_KEY. EMAIL_PROVIDER=postmark uses POSTMARK_SERVER_TOKEN.
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_replace_with_resend_api_key"
POSTMARK_SERVER_TOKEN=""
EMAIL_FROM="AiAiAiRouter <notifications@example.com>"
EMAIL_REPLY_TO="support@example.com"

# Base64-encoded 32-byte key for encrypting provider keys stored in provider_keys (generate: openssl rand -base64 32).
PROVIDER_ENCRYPTION_KEY="MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA="
# Provider credentials are optional. A provider is served only when its real key is configured.
DEEPSEEK_API_KEY=""
DASHSCOPE_API_KEY=""
MOONSHOT_API_KEY=""
ZHIPU_API_KEY=""
# Optional upstream for the rotating zero-price model pool at openrouter/free.
OPENROUTER_API_KEY=""
# Optional endpoint overrides for a provider's OpenAI-compatible /v1 base URL.
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DASHSCOPE_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
MOONSHOT_BASE_URL="https://api.moonshot.ai/v1"
ZHIPU_BASE_URL="https://api.z.ai/api/paas/v4"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Optional distributed rate limiting. Without these values an atomic Postgres fixed-window limiter is used.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Gateway limits: requests per minute per key and per account.
GATEWAY_KEY_RATE_LIMIT="60"
GATEWAY_USER_RATE_LIMIT="120"
# Maximum time the gateway waits for provider headers, in milliseconds.
PROVIDER_TIMEOUT_MS="60000"
